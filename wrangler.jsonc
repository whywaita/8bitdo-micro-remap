{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "8bitdo-micro-configurator",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
}
